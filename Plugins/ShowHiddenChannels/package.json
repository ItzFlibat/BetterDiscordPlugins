        "@babel/preset-typescript": "^7.26.0",
        "@types/node": "^20.11.16",
        "babel-loader": "^9.2.1",
        "typescript": "^5.3.3",
        "webpack": "^5.98.0",
        "webpack-cli": "^5.1.4"

{
    "name": "showhiddenchannels",
    "description": "Show hidden channels and inspect locally available channel information and permissions.",
    "version": "2.2.4",
    "private": true,
    "main": "ShowHiddenChannels.plugin.js",
    "scripts": {
        "build": "bun run typecheck && bun run webpack",
        "typecheck": "tsc --noEmit",
